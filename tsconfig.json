{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "itinera/*": ["./packages/itinera/src/*.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "packages/*/examples",
    "*.mjs",
    "*.mts"
  ]
}
