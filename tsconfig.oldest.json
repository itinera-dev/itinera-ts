{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "itinera/*": ["./packages/itinera/src/*.ts"]
    }
  },
  "include": [
    "packages/itinera/src",
    "packages/itinera/tests",
    "packages/itinera/examples"
  ],
  "exclude": ["packages/itinera/tests/integration/reference.test.ts"]
}
