{
  "$schema": "https://typedoc.org/schema.json",
  "name": "itinera",
  "readme": "README.md",
  "entryPoints": [
    "src/closed-set.ts",
    "src/event.ts",
    "src/executor.ts",
    "src/instance.ts",
    "src/journey.ts",
    "src/option.ts",
    "src/policy.ts",
    "src/report.ts",
    "src/schema.ts",
    "src/service.ts",
    "src/step.ts",
    "src/testing.ts",
    "src/unstable.ts",
    "src/value.ts",
    "src/workflow.ts"
  ],
  "tsconfig": "tsconfig.build.json",
  "out": "api",
  "plugin": ["./typedoc/accessible.mjs"],
  "customCss": "typedoc/accessible.css",
  "navigation": {
    "includeFolders": false
  },
  "navigationLeaves": [
    "itinera/closed-set",
    "itinera/event",
    "itinera/executor",
    "itinera/instance",
    "itinera/journey",
    "itinera/option",
    "itinera/policy",
    "itinera/report",
    "itinera/schema",
    "itinera/service",
    "itinera/step",
    "itinera/testing",
    "itinera/unstable",
    "itinera/value",
    "itinera/workflow"
  ],
  "excludeExternals": true,
  "externalSymbolLinkMappings": {
    "ts-results-es": {
      "*": "https://github.com/lune-climate/ts-results-es#readme"
    },
    "zod": {
      "*": "https://zod.dev/api"
    }
  },
  "navigationLinks": {
    "Itinera": "https://itinera-dev.org/",
    "Specification": "https://github.com/itinera-dev/spec",
    "GitHub": "https://github.com/itinera-dev/itinera-ts"
  },
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  }
}
