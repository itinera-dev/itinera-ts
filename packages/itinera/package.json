{
  "name": "itinera",
  "version": "0.0.0",
  "description": "A workflow framework that keeps business rules separate from flow control.",
  "keywords": [
    "workflow",
    "orchestration",
    "business-rules",
    "retry",
    "agent"
  ],
  "homepage": "https://itinera-dev.org/",
  "bugs": "https://github.com/itinera-dev/itinera-ts/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itinera-dev/itinera-ts.git",
    "directory": "packages/itinera"
  },
  "license": "MIT OR Apache-2.0",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./unstable": {
      "import": {
        "types": "./dist/unstable.d.mts",
        "default": "./dist/unstable.mjs"
      },
      "require": {
        "types": "./dist/unstable.d.ts",
        "default": "./dist/unstable.js"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema.d.mts",
        "default": "./dist/schema.mjs"
      },
      "require": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      }
    },
    "./value": {
      "import": {
        "types": "./dist/value.d.mts",
        "default": "./dist/value.mjs"
      },
      "require": {
        "types": "./dist/value.d.ts",
        "default": "./dist/value.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "tag": "next"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "ts-results-es": "7.1.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.2"
  }
}
